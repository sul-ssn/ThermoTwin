  "components": {
    "schemas": {
      "Constraints": {
        "properties": {
          "consider_supply": {
            "type": "boolean",
            "title": "Consider Supply",
            "default": true
          },
          "consider_return": {
            "type": "boolean",
            "title": "Consider Return",
            "default": true
          },
          "allow_backup_routes": {
            "type": "boolean",
            "title": "Allow Backup Routes",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Constraints"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentCreate": {
        "properties": {
          "simulation_id": {
            "type": "string",
            "title": "Simulation Id"
          },
          "variant_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Variant Index",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "simulation_id"
        ],
        "title": "IncidentCreate"
      },
      "IncidentInput": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "pipe_break",
              "valve_failure",
              "pressure_drop"
            ],
            "title": "Type"
          },
          "segment_id": {
            "type": "string",
            "title": "Segment Id"
          },
          "pressure_factor": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Pressure Factor",
            "default": 0.6
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "segment_id"
        ],
        "title": "IncidentInput"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Reading": {
        "properties": {
          "sensor_id": {
            "type": "string",
            "title": "Sensor Id"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sensor_id",
          "value",
          "timestamp"
        ],
        "title": "Reading"
      },
      "SimulationInput": {
        "properties": {
          "network_version": {
            "type": "string",
            "title": "Network Version"
          },
          "incident": {
            "$ref": "#/components/schemas/IncidentInput"
          },
          "constraints": {
            "$ref": "#/components/schemas/Constraints"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "network_version",
          "incident"
        ],
        "title": "SimulationInput"
      },
      "TelemetryProfile": {
        "properties": {
          "profile": {
            "type": "string",
            "title": "Profile"
          }
        },
        "type": "object",
        "required": [
          "profile"
        ],
        "title": "TelemetryProfile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
